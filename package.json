{
  "name": "kastren",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch services/api/src/server.ts",
    "build:desktop": "tauri build",
    "build:android": "npm run build && cap sync android && cap open android",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev --schema services/api/prisma/schema.prisma",
    "db:generate": "prisma generate --schema services/api/prisma/schema.prisma",
    "db:seed": "tsx services/api/prisma/seed.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "test:api": "vitest run services/api/src/app.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.6.9",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "argon2": "^0.44.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.6.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@prisma/adapter-pg": "7.10.1",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "prisma": "7.10.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
