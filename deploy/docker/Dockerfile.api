# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------------
# Stage 1: Build & compile TypeScript and Prisma client
# -----------------------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy package manifests
COPY package.json package-lock.json ./
COPY tsconfig.json tsconfig.app.json tsconfig.node.json prisma.config.ts ./
COPY packages/ ./packages/
COPY services/api/ ./services/api/

# Install all dependencies (including devDependencies for build)
RUN npm ci

# Generate Prisma Client & compile TypeScript
RUN npx prisma generate --schema services/api/prisma/schema.prisma
RUN npx tsc -b --pretty false

# Prune devDependencies to keep image lean
RUN npm prune --production

# -----------------------------------------------------------------------------
# Stage 2: Hardened, minimal production runtime
# -----------------------------------------------------------------------------
FROM node:22-alpine AS runner

WORKDIR /app

# Security: Install dumb-init for proper signal forwarding and PID 1 reaper
RUN apk add --no-cache dumb-init curl

# Enforce production environment
ENV NODE_ENV=production
ENV API_PORT=3000

# Copy runtime assets from builder
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/services/api ./services/api
COPY --from=builder /app/packages ./packages

# Security: Switch to non-root user provided by node image
USER node

EXPOSE 3000

# Native healthcheck using curl against loopback health route
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://127.0.0.1:3000/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "services/api/src/server.js"]
