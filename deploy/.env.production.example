# Kastren Production Environment Template
# Copy this to .env.production on your production server:
# Or generate automatically with: node scripts/generate-production-secrets.js

NODE_ENV=production
API_PORT=3000

# Mandatory: At least 32 characters (recommended: 64 random characters)
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SESSION_SECRET_AT_LEAST_32_CHARS

# Mandatory: Strong database password for postgres container
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DB_PASSWORD

# Mandatory: Exact public HTTPS origin (enforces secure cookies & strict CORS/CSRF)
WEB_ORIGIN=https://kastren.example.com

# PostgreSQL Connection String (internal container network)
DATABASE_URL=postgresql://kastren:REPLACE_WITH_STRONG_RANDOM_DB_PASSWORD@db:5432/kastren?schema=public

# Optional: Email Service for Password Resets (Choose Resend or SMTP)
# Option A: Resend API
# RESEND_API_KEY=re_123456789
# Option B: Standard SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=smtp-username
# SMTP_PASS=smtp-password
# SMTP_SECURE=false
EMAIL_FROM=Kastren <noreply@kastren.example.com>

# Optional: Offsite Backup Sync
# S3_BUCKET=my-kastren-backups
# RCLONE_DEST=remote:kastren-backups

